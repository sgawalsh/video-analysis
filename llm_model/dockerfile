FROM ollama/ollama@sha256:ccc42bcd3d5fcf7ab0d532b300382154e1a4da56fc666bdb313b78ebdd912754 AS base

# Set the environment variable so Ollama listens on all interfaces inside the container
ENV OLLAMA_HOST=0.0.0.0:11434
ENV OLLAMA_KEEP_ALIVE=-1
ENV OLLAMA_NUM_PARALLEL=1
ENV OLLAMA_MAX_LOADED_MODELS=1

EXPOSE 11434

# Target 1: Download model into persistent storage
FROM base AS download

COPY pull-model.sh /usr/local/bin/pull-model.sh

ENTRYPOINT ["/usr/local/bin/pull-model.sh"]

# Target 2: Actual model service
FROM base AS serve

CMD ["serve"]